{#
/**
 * @file
 * Dialogflow Messenger (Event Parking Assistant).
 *
 * @see template_preprocess_page()
 * Adds chatbot
 */
#}
{# Dialogflow Messenger Integration #}
<style>
  /* Stanford brand colors:
     Cardinal red: #8C1515
     Dark red:     #820000
     Light sand:   #F4F0E8
     Cool grey:    #4D4F53
     White:        #FFFFFF
  */

  /* Scoped to this embed only — does not alter page body or global layout */
  .lbre-event-parking-assistant .stanford-header {
    background: #8C1515;
    color: #fff;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
  }
  .lbre-event-parking-assistant .stanford-header .seal {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }
  .lbre-event-parking-assistant .stanford-header .title-block h1 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .lbre-event-parking-assistant .stanford-header .title-block p {
    margin: 2px 0 0;
    font-size: 13px;
    opacity: 0.85;
  }

  .lbre-event-parking-assistant df-messenger {
    z-index: 999;
    position: fixed;
    bottom: 20px;
    right: 20px;

    /* Bubble / FAB button */
    --df-messenger-button-titlebar-color: #8C1515;
    --df-messenger-button-titlebar-font-color: #fff;

    /* Chat window titlebar */
    --df-messenger-titlebar-background: #8C1515;
    --df-messenger-titlebar-font-color: #fff;
    --df-messenger-titlebar-icon-color: #fff;

    /* Chat background */
    --df-messenger-chat-background: #F4F0E8;
    --df-messenger-font-color: #2e2d29;
    --df-messenger-font-family: 'Source Sans Pro', 'Google Sans', sans-serif;

    /* User message bubble */
    --df-messenger-message-user-background: #8C1515;
    --df-messenger-message-user-font-color: #fff;

    /* Bot message bubble */
    --df-messenger-message-bot-background: #fff;
    --df-messenger-message-bot-font-color: #2e2d29;
    --df-messenger-message-bot-border-color: #d4c5a9;

    /* Input bar */
    --df-messenger-input-background: #fff;
    --df-messenger-input-font-color: #2e2d29;
    --df-messenger-input-placeholder-font-color: #888;
    --df-messenger-input-border-color: #c9b99a;

    /* Send button */
    --df-messenger-send-icon: #8C1515;

    /* Focus / accent */
    --df-messenger-focus-color: #820000;

    /* Chip / suggestion buttons */
    --df-messenger-chip-background: #fff;
    --df-messenger-chip-font-color: #8C1515;
    --df-messenger-chip-border-color: #8C1515;
  }
</style>

<div class="lbre-event-parking-assistant">
  <header class="stanford-header">
    <svg class="seal" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="48" fill="none" stroke="#fff" stroke-width="2"/>
      <text x="50" y="38" text-anchor="middle" font-size="11" fill="#fff" font-family="serif" font-weight="bold">STANFORD</text>
      <text x="50" y="52" text-anchor="middle" font-size="11" fill="#fff" font-family="serif" font-weight="bold">UNIVERSITY</text>
      <text x="50" y="68" text-anchor="middle" font-size="9" fill="#f9c858" font-family="serif">Est. 1885</text>
    </svg>
    <div class="title-block">
      <h1>Stanford University</h1>
      <p>Event Parking Assistant</p>
    </div>
  </header>

  <div class='chatbot-wrapper'>
    <link rel="stylesheet" href="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/themes/df-messenger-default.css">
    <script src="https://www.gstatic.com/dialogflow-console/fast/df-messenger/prod/v1/df-messenger.js"></script>
    <df-messenger
      project-id="lbre-applications"
      agent-id="d85e87df-9a7d-4857-b3fd-108ceb7109dd"
      language-code="en"
      max-query-length="-1">
      <df-messenger-chat-bubble
        chat-title="Stanford Event Parking"
        intent="WELCOME">
      </df-messenger-chat-bubble>
    </df-messenger>
  </div>
</div>
